{
    "description": "2D Harmonic Trap - Standard configuration for two-dimensional BEC simulations with anisotropic trapping",
    "simulation": {
        "dimension": 2,
        "dt": 0.001,
        "T": 8.0,
        "Nt": 8000,
        "save_every": 80,
        "mode": "evolution"
    },
    "grid": {
        "Nx": 128,
        "Ny": 128,
        "Nz": 1,
        "Lx": 12.0,
        "Ly": 12.0,
        "Lz": 1.0
    },
    "parameters": {
        "epsilon": 0.01,
        "kappa": 1.0,
        "gamma_y": 1.5,
        "gamma_z": 1.0
    },
    "potential": {
        "type": "harmonic",
        "parameters": {
            "gamma_y": 1.5
        }
    },
    "initial_condition": {
        "type": "gaussian",
        "parameters": {
            "sigma_x": 1.2,
            "sigma_y": 1.0
        }
    },
    "ground_state": {
        "method": "imaginary_time",
        "dt_imag": 0.01,
        "tolerance": 1e-8,
        "max_iter": 8000
    },
    "visualization": {
        "plot_density": true,
        "plot_widths": true,
        "animate": true,
        "save_video": false,
        "calculate_observables": true,
        "frame_rate": 25
    }
} 