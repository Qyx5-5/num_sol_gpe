{
    "description": "Ground State Calculation - Optimized configuration for finding ground states using imaginary time evolution",
    "simulation": {
        "dimension": 2,
        "dt": 0.001,
        "T": 20.0,
        "Nt": 20000,
        "save_every": 400,
        "mode": "ground_state"
    },
    "grid": {
        "Nx": 128,
        "Ny": 128,
        "Nz": 1,
        "Lx": 12.0,
        "Ly": 12.0,
        "Lz": 1.0
    },
    "parameters": {
        "epsilon": 0.01,
        "kappa": 1.0,
        "gamma_y": 1.0,
        "gamma_z": 1.0
    },
    "potential": {
        "type": "harmonic",
        "parameters": {}
    },
    "initial_condition": {
        "type": "gaussian",
        "parameters": {
            "sigma_x": 1.0,
            "sigma_y": 1.0
        }
    },
    "ground_state": {
        "method": "imaginary_time",
        "dt_imag": 0.01,
        "tolerance": 1e-10,
        "max_iter": 15000
    },
    "visualization": {
        "plot_density": true,
        "plot_widths": true,
        "animate": false,
        "save_video": false,
        "calculate_observables": true,
        "frame_rate": 20
    }
} 